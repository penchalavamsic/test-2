# Environment Variables

# Application URL (required)
LIMAS_BASE_URL=

# SUPER_USER credentials
LIMAS_SUPER_USER_USERNAME=
LIMAS_SUPER_USER_PASSWORD=

# ADMIN credentials
LIMAS_ADMIN_USERNAME=
LIMAS_ADMIN_PASSWORD=

# SUPER_USER_ADMIN_USER credentials
LIMAS_SUPER_USER_ADMIN_USER_USERNAME=
LIMAS_SUPER_USER_ADMIN_USER_PASSWORD=

# Default access profile
LIMAS_DEFAULT_ACCESS_PROFILE=SUPER_USER_ADMIN_USER

# Runtime access profile override (set by runner; ADMIN, SUPER_USER, or SUPER_USER_ADMIN_USER)
LIMAS_ACCESS_PROFILE=

# CI-aware Playwright configuration (optional overrides)
PLAYWRIGHT_TEST_TIMEOUT=
PLAYWRIGHT_EXPECT_TIMEOUT=
PLAYWRIGHT_RETRIES=
PLAYWRIGHT_WORKERS=

# Authentication timing: milliseconds. No application or Keycloak settings are changed.
LIMAS_AUTH_TIMEOUT_MS=60000
LIMAS_AUTH_SETUP_TIMEOUT_MS=180000
LIMAS_AUTH_EXPIRY_MARGIN_MS=30000

# Evidence is enabled by default for successful and failed tests.
# Set off only when intentionally running without per-step screenshots/video retention.
PLAYWRIGHT_EVIDENCE_MODE=detailed
PLAYWRIGHT_SCREENSHOT_TIMEOUT_MS=3000
PLAYWRIGHT_EVIDENCE_MASK_SELECTORS=[]
PLAYWRIGHT_ACTION_TIMEOUT_MS=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=60000
PLAYWRIGHT_BROWSER_CHANNEL=msedge
LIMAS_CHECKLIST_PATH=inventory/LIMAS_3_Simple_Test_Checklist_AUTH-01_ADDED.xlsx
# Generated form values use a reserved, non-deliverable domain by default.
LIMAS_TEST_EMAIL_DOMAIN=example.invalid

# Optional, explicitly targeted real approval test (LIMAS-SUD-151).
# Leave blank unless deliberately approving the selected pending request.
TEST_RECORD_IDENTIFIER=
TEST_RECORD_USER_NAME=
TEST_USER_GROUP=
TEST_PROFILE=
TEST_ROLE=
TEST_EXPIRATION_DATE=
TEST_MAINTENANCE_DATE=
